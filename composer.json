{
    "name": "sovereign-stack/dglab",
    "description": "Sovereign Stack \u2014 DGLab monorepo",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pcre": "*",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "sovereign-stack/core-config": "*",
        "sovereign-stack/core-container": "*",
        "sovereign-stack/core-error-handler": "*",
        "sovereign-stack/core-event-dispatcher": "*",
        "sovereign-stack/core-http-message": "*",
        "sovereign-stack/core-kernel": "*",
        "sovereign-stack/core-logger": "*",
        "sovereign-stack/core-middleware": "*",
        "sovereign-stack/core-router": "*",
        "sovereign-stack/hub-config": "*",
        "sovereign-stack/bridge-vanguard": "*",
        "sovereign-stack/spoke-codex": "*",
        "sovereign-stack/spoke-canvas": "*",
        "sovereign-stack/core-dbal": "*",
        "sovereign-stack/core-crypto": "*"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "SovereignStack\\Core\\Container\\": "packages/core/container/src/",
            "SovereignStack\\Core\\EventDispatcher\\": "packages/core/event-dispatcher/src/",
            "SovereignStack\\Core\\Http\\": "packages/core/http-message/src/",
            "SovereignStack\\Core\\Router\\": "packages/core/router/src/",
            "SovereignStack\\Core\\Config\\": "packages/core/config/src/",
            "SovereignStack\\Core\\Logger\\": "packages/core/logger/src/",
            "SovereignStack\\Core\\ErrorHandler\\": "packages/core/error-handler/src/",
            "SovereignStack\\Core\\Kernel\\": "packages/core/kernel/src/",
            "SovereignStack\\Core\\Database\\": "packages/core/dbal/src/",
            "SovereignStack\\Hub\\Config\\": "packages/hub/config/src/",
            "SovereignStack\\Bridge\\": "packages/bridge/vanguard/src/",
            "SovereignStack\\Internal\\Codex\\": "packages/spoke/internal/codex/src/",
            "SovereignStack\\External\\Canvas\\": "packages/spoke/external/canvas/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\Tests\\": "app/tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*/*"
        },
        {
            "type": "path",
            "url": "packages/*/*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    }
}
