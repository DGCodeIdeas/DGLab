{
    "name": "sovereign-stack/dglab",
    "description": "Sovereign Stack \u2014 DGLab monorepo",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pcre": "*",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "sovereign-stack/core-config": "*",
        "sovereign-stack/core-container": "*",
        "sovereign-stack/core-error-handler": "*",
        "sovereign-stack/core-event-dispatcher": "*",
        "sovereign-stack/core-http-message": "*",
        "sovereign-stack/core-kernel": "*",
        "sovereign-stack/core-logger": "*",
        "sovereign-stack/core-middleware": "*",
        "sovereign-stack/core-router": "*",
        "sovereign-stack/hub-config": "*",
        "sovereign-stack/bridge-vanguard": "*",
        "sovereign-stack/spoke-codex": "*",
        "sovereign-stack/spoke-canvas": "*",
        "sovereign-stack/core-dbal": "*",
        "sovereign-stack/core-crypto": "*",
        "sovereign-stack/hub-identity": "*",
        "sovereign-stack/spoke-showcase": "*",
        "sovereign-stack/spoke-lms": "*",
        "sovereign-stack/core-view": "*"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
"autoload": {
        "psr-4": {
            "App\\": "app/",
            "SovereignStack\\Core\\Container\\": "Core/Container/",
            "SovereignStack\\Core\\EventDispatcher\\": "Core/EventDispatcher/",
            "SovereignStack\\Core\\Http\\": ["Core/HttpMessage/", "Core/Middleware/"],
            "SovereignStack\\Core\\Router\\": "Core/Router/",
            "SovereignStack\\Core\\Config\\": "Core/Config/",
            "SovereignStack\\Core\\Logger\\": "Core/Logger/",
            "SovereignStack\\Core\\ErrorHandler\\": "Core/ErrorHandler/",
            "SovereignStack\\Core\\Kernel\\": "Core/Kernel/",
            "SovereignStack\\Core\\Database\\": "Core/Database/",
            "SovereignStack\\Core\\Filesystem\\": "Core/Filesystem/",
            "SovereignStack\\Core\\NeoSpx\\": "Core/NeoSpx/",
            "SovereignStack\\Core\\Crypto\\": "Core/Crypto/",
            "SovereignStack\\Core\\View\\": "Core/View/",
            "SovereignStack\\Hub\\Config\\": "Hub/Config/",
            "SovereignStack\\Bridge\\": "Bridge/Vanguard/",
            "SovereignStack\\Internal\\Codex\\": "Spokes/Internal/Codex/",
            "SovereignStack\\External\\Canvas\\": "Spokes/External/Canvas/",
            "SovereignStack\\Hub\\Identity\\": "Hub/Identity/",
            "SovereignStack\\Internal\\Showcase\\": "Spokes/Internal/Showcase/",
            "SovereignStack\\Internal\\Lms\\": "Spokes/Internal/Lms/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\Container\\Tests\\": "Core/Container/tests/",
            "SovereignStack\\Core\\Filesystem\\Tests\\": "Core/Filesystem/tests/",
            "Tests\\": "tests/",
            "App\\Tests\\": "app/tests/",
            "SovereignStack\\Hub\\Identity\\Tests\\": "Hub/Identity/tests/",
            "SovereignStack\\Internal\\Showcase\\Tests\\": "Spokes/Internal/Showcase/tests/",
            "SovereignStack\\Internal\\Lms\\Tests\\": "Spokes/Internal/Lms/tests/",
            "SovereignStack\\Core\\Kernel\\Tests\\": "Core/Kernel/tests/",
            "SovereignStack\\Core\\NeoSpx\\Tests\\": "Core/NeoSpx/tests/",
            "SovereignStack\\Core\\Config\\Tests\\": "Core/Config/tests/",
            "SovereignStack\\Core\\EventDispatcher\\Tests\\": "Core/EventDispatcher/tests/",
            "SovereignStack\\Core\\Router\\Tests\\": "Core/Router/tests/",
            "SovereignStack\\Core\\Crypto\\Tests\\": "Core/Crypto/tests/",
            "SovereignStack\\Core\\Http\\Tests\\": ["Core/HttpMessage/tests/", "Core/Middleware/tests/"]
        }
    },
    "repositories": [],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    }
}
