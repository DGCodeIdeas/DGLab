{
    "name": "sovereign-stack/spoke-showcase",
    "description": "Showcase Spoke — product catalog + asset management app",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0.0",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "psr/http-message": "^2.0",
        "sovereign-stack/core-container": "*",
        "sovereign-stack/core-dbal": "*",
        "sovereign-stack/core-event-dispatcher": "*",
        "sovereign-stack/core-http-message": "*",
        "sovereign-stack/core-kernel": "*",
        "sovereign-stack/hub-identity": "*",
        "sovereign-stack/core-filesystem": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Spoke\\Showcase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Spoke\\Showcase\\Tests\\": "tests/"
        }
    }
}
