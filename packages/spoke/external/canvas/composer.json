{
    "name": "sovereign-stack/spoke-canvas",
    "description": "ESPOKE-01: Sovereign Canvas — public-facing CMS and delivery engine. Renders pages from content fetched via BRIDGE-01, with SEO validation and stale-while-revalidate caching.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0.0",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "psr/http-message": "^2.0",
        "sovereign-stack/core-http-message": "^0.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\External\\Canvas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\External\\Canvas\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../core/http-message"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
