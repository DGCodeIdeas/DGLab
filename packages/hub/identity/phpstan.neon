includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    paths:
        - src
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#has parameter \$roles with no value type specified in iterable type array#'
        - '#does not accept array#'
        - '#Constant OPENSSL_ALG_SHA256 not found#'
        - '#openssl_(sign|verify) expects int|string, mixed given#'
        - '#should return array<string, mixed> but returns array#'
        - '#Value assigned to variable \$seqLen only flows into values that are never used#'
        - '#Binary operation#'
        - '#Cannot access offset#'
        - '#Cannot cast mixed to string#'
