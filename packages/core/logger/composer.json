{
    "name": "sovereign-stack/core-logger",
    "description": "CORE-09: PSR-3 Structured Logging Service with HandlerStack, JSON/Line formatters, and flock-protected file handler",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0.0",
    "require": {
        "php": "^8.3",
        "psr/log": "^3.0",
        "sovereign-stack/core-config": "^0.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Core\\Logger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\Logger\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../config"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
