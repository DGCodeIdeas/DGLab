parameters:
    level: max
    paths:
        - src/
        - tests/
    ignoreErrors:
        - '#Property .*::\$pulseInstances with generic class WeakMap does not specify its types#'
        - '#Property .*::\$fiberResolving with generic class WeakMap does not specify its types#'
        - '#Cannot access offset string on mixed#'
        - '#Parameter #2 \$array of function array_key_exists expects array, mixed given#'
