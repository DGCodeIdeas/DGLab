parameters:
    level: max
    paths:
        - src/
        - tests/
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#with generic class WeakMap does not specify its types: TKey, TValue#'
        -
            message: '#Cannot access offset string on mixed#'
        -
            message: '#Parameter #2 \$array of function array_key_exists expects array, mixed given#'
        -
            message: '#with generic class Fiber does not specify its types: TStart, TResume, TReturn, TSuspend#'
