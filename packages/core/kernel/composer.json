{
    "name": "sovereign-stack/core-kernel",
    "description": "CORE-18: The Sovereign Kernel \u2014 orchestrates the request lifecycle from boot to terminate, wiring all Core-tier components into the Pulse round-trip",
    "type": "library",
    "license": "MIT",
    "version": "0.4.0.0",
    "require": {
        "php": "^8.4",
        "psr/http-message": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "sovereign-stack/core-container": "*",
        "sovereign-stack/core-event-dispatcher": "*",
        "sovereign-stack/core-http-message": "*",
        "sovereign-stack/core-middleware": "*",
        "sovereign-stack/core-router": "*",
        "sovereign-stack/core-config": "*",
        "sovereign-stack/core-logger": "*",
        "sovereign-stack/core-error-handler": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Core\\Kernel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\Kernel\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../container"
        },
        {
            "type": "path",
            "url": "../event-dispatcher"
        },
        {
            "type": "path",
            "url": "../http-message"
        },
        {
            "type": "path",
            "url": "../middleware"
        },
        {
            "type": "path",
            "url": "../router"
        },
        {
            "type": "path",
            "url": "../config"
        },
        {
            "type": "path",
            "url": "../logger"
        },
        {
            "type": "path",
            "url": "../error-handler"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
