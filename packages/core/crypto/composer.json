{
    "name": "sovereign-stack/core-crypto",
    "description": "Binary Encryption Envelope (AES-256-GCM, Argon2id, HKDF-SHA256) — CORE-16",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0.0",
    "require": {
        "php": "^8.4",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "ext-hash": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Core\\Crypto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\Crypto\\Tests\\": "tests/"
        }
    }
}
