{
    "name": "sovereign-stack/core-dbal",
    "description": "CORE-19: Database Abstraction Layer — thin PDO wrapper with fluent QueryBuilder, nested transactions, and tenant scoping",
    "type": "library",
    "license": "MIT",
    "version": "0.6.0.0",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Core\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\Database\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
