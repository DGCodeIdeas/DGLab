{
    "name": "sovereign-stack/core-cache",
    "description": "CORE-15: Cache Abstraction (PSR-6/16)",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "psr/cache": "^3.0",
        "psr/simple-cache": "^3.0",
        "ext-json": "*"
    },
    "suggest": {
        "ext-redis": "^5.3 || ^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Core\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\Cache\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
