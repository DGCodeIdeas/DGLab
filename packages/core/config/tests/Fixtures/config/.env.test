# Test .env file for EnvLoader tests.

APP_NAME=DGLab
APP_ENV=testing
APP_DEBUG=true
APP_URL=https://${BASE_URL}/api

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dglab_test

# Single-quoted — no interpolation
SINGLE_QUOTED='${NOT_EXPANDED}'

# Double-quoted — interpolation applies
DOUBLE_QUOTED="prefix-${APP_NAME}-suffix"

# Bare value
BARE_VALUE=hello-world

# With export prefix
export EXPORTED_KEY=exported-value

# Comment line below should be skipped
# IGNORED_KEY=should-not-load
