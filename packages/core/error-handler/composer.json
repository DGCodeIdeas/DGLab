{
    "name": "sovereign-stack/core-error-handler",
    "description": "CORE-08: Global Error & Exception Handler with PSR-3 logging, multi-format rendering, and security-aware stack-trace sanitization",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "psr/log": "^3.0",
        "sovereign-stack/core-logger": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Core\\ErrorHandler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\ErrorHandler\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../config"
        },
        {
            "type": "path",
            "url": "../logger"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
