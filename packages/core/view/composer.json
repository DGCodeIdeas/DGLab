{
    "name": "sovereign-stack/core-view",
    "description": "CORE view rendering \u2014 application-facing template driver contract with Twig support",
    "type": "library",
    "license": "Apache-2.0",
    "version": "0.1.0.0",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "twig/twig": "^3.22",
        "sovereign-stack/core-config": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Core\\View\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\View\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
