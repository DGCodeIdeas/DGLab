{
    "name": "sovereign-stack/core-http-message",
    "description": "CORE-04: PSR-7 HTTP Message & PSR-17 Factory implementations",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "php-http/psr7-integration-tests": "^1.3",
        "http-interop/http-factory-tests": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Core\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\Http\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
