{
    "name": "sovereign-stack/core-neospx",
    "description": "CORE-07: NeoSPX Lexer — stateful mode-stacked lexer for the NeoSPX template language",
    "type": "library",
    "license": "Apache-2.0",
    "version": "0.1.0.0",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pcre": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Core\\NeoSPX\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\NeoSPX\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}