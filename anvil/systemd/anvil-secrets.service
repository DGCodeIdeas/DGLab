# /etc/systemd/system/anvil-secrets.service — Anvil v3 secrets fetch (SSM → EnvironmentFile)
# §7.8 of v3 doc.
#
# Runs BEFORE the frankenphp units. Writes /etc/anvil/secrets.env (0600 root:anvil)
# from SSM Parameter Store SecureString paths under /anvil/rds/*.
# When HUB-20 (Sovereign Vault) lands, this unit is the single swap point.
[Unit]
Description=Anvil v3 secrets fetch (SSM → EnvironmentFile)
Before=anvil-frankenphp@blue.service anvil-frankenphp@green.service

[Service]
Type=oneshot
ExecStart=/opt/anvil/lib/fetch-secrets.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
