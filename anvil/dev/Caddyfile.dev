# anvil/dev/Caddyfile.dev — collapsed-mode dev config (adjusted for port conflicts).
#
# FrankenPHP embeds Caddy. In dev collapsed mode, this IS the whole stack:
# TLS (mkcert) + HTTP + PHP in one process.
#
# NOTE: Uses port 8443 for HTTPS to avoid conflict with the host Caddy service
#       running on port 80/443. Access at https://dglab.test:8443

{
    # Admin on port 2019 (standard in dev).
    admin 127.0.0.1:2019

    log {
        output stdout
        format console
        level DEBUG
    }

    frankenphp {
        # php_server handles request dispatch — works with standard PHP apps
        # that do NOT call frankenphp_handle_request().
        php_server
        php_ini "display_errors" "1"
        php_ini "opcache.enable" "1"
        php_ini "opcache.validate_timestamps" "1"
        php_ini "opcache.revalidate_freq" "0"
    }
}

:8443 {
    tls /home/dgi/www/DGLab/anvil/dev/tls/test.pem /home/dgi/www/DGLab/anvil/dev/tls/test-key.pem
    root * /home/dgi/www/DGLab/public/
    encode zstd gzip
    file_server
    php_server
    log {
        output stdout
        format console
    }
}

:8080 {
    redir https://:8443{uri} permanent
}
