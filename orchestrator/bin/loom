#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * The Loom — CORE-01 Polyrepo Orchestrator CLI
 *
 * Central entry point for orchestrating the Sovereign Stack polyrepo lifecycle.
 */

// Determine autoload path — support both installed and development modes
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../vendor/autoload.php',
];

$autoloaded = false;
foreach ($autoloadPaths as $path) {
    if (\file_exists($path)) {
        require $path;
        $autoloaded = true;
        break;
    }
}

if (!$autoloaded) {
    \fwrite(\STDERR, "ERROR: Cannot find autoload.php. Run 'composer install' first.\n");
    exit(1);
}

use SovereignStack\Orchestrator\CiGate;
use SovereignStack\Orchestrator\CIMonitor;
use SovereignStack\Orchestrator\DependencyGraph;
use SovereignStack\Orchestrator\MonorepoPackage;
use SovereignStack\Orchestrator\RepoManager;
use SovereignStack\Orchestrator\VersionBumpEngine;

// ─── Argument Parsing ───────────────────────────────────────────────────────

$args = \array_slice($argv, 1);

if ($args === []) {
    printUsage();
    exit(0);
}

$command = $args[0];

// ─── Command Routing ────────────────────────────────────────────────────────

match ($command) {
    'ci:monitor' => handleCiMonitor(\array_slice($args, 1)),
    'version:bump' => handleVersionBump(\array_slice($args, 1)),
    'tag:create' => handleTagCreate(\array_slice($args, 1)),
    'tag:push' => handleTagPush(\array_slice($args, 1)),
    'package:list' => handlePackageList(\array_slice($args, 1)),
    'status:clean' => handleStatusClean(\array_slice($args, 1)),
    'status' => handleStatus(\array_slice($args, 1)),
    default => printUsage(),
};

// ─── Command Handlers ───────────────────────────────────────────────────────

function handleCiMonitor(array $subArgs): void
{
    $monitor = new CIMonitor();
    $config = loadConfig();

    foreach ($config as $repo) {
        $monitor->registerRepo($repo['name'], $repo['ci_url'], $repo['token'] ?? '');
    }

    $checkAll = \in_array('--all', $subArgs, true);

    if ($checkAll) {
        $results = $monitor->checkAll();
        printResultsTable($results);
        return;
    }

    if (isset($subArgs[0])) {
        $result = $monitor->check($subArgs[0]);
        printResultsTable([$subArgs[0] => $result]);
        return;
    }

    \fwrite(\STDERR, "Usage: loom ci:monitor [--all | <repo-name>]\n");
    exit(1);
}

function handleVersionBump(array $subArgs): void
{
    if ($subArgs === []) {
        \fwrite(\STDERR, "Usage: loom version:bump <package>\n");
        \fwrite(\STDERR, "       <package> is a monorepo package name (e.g. core/container) or a repos.json entry name.\n");
        exit(1);
    }

    $repoName = $subArgs[0];
    $engine = new VersionBumpEngine();

    // Resolve the package: try monorepo first, fall back to legacy repos.json.
    $repoRoot = \dirname(__DIR__);
    $package = MonorepoPackage::find($repoRoot, $repoName);

    if ($package !== null) {
        $manager = $package->createRepoManager($repoRoot);
        $displayName = $package->name . " (path: {$package->path}, prefix: {$package->tagPrefix})";
    } else {
        // Legacy mode — look up in repos.json
        $repoDir = getRepoDir($repoName);
        $manager = new RepoManager($repoDir);
        $displayName = $repoName;
    }

    try {
        $currentVersion = $manager->getCurrentVersion();
        $log = $manager->getLogSince($currentVersion);
        $analysis = $engine->analyze($log);
        $newVersion = $engine->calculateNewVersion($currentVersion, $analysis['increment']);

        echo "Package:          {$displayName}\n";
        echo "Current version: {$currentVersion}\n";
        echo "New version:     {$newVersion}\n";
        echo "Increment:       {$analysis['increment']}\n";
        echo "Reason:          {$analysis['reason']}\n";
        echo "Commits analyzed: " . \count($log) . "\n";
    } catch (\RuntimeException $e) {
        \fwrite(\STDERR, "Error: " . $e->getMessage() . "\n");
        exit(1);
    }
}

function handleTagCreate(array $subArgs): void
{
    if (\count($subArgs) < 2) {
        \fwrite(\STDERR, "Usage: loom tag:create <package> <version> [options]\n");
        \fwrite(\STDERR, "       <version> is bare SemVer (e.g. 1.1.0) — the tag prefix is added automatically.\n");
        \fwrite(\STDERR, "Options:\n");
        \fwrite(\STDERR, "       --message <msg>           Annotated-tag message (default: \"Release <version>\").\n");
        \fwrite(\STDERR, "       --require-ci-green        Refuse to tag if the latest run of --ci-workflow is not green.\n");
        \fwrite(\STDERR, "       --ci-workflow <file>      Workflow file name (default: packages-ci.yml).\n");
        \fwrite(\STDERR, "       --ci-branch <name>        Branch to check (default: \$GITHUB_REF_NAME or 'main').\n");
        \fwrite(\STDERR, "       --ci-repo <owner/name>    GitHub repo (default: \$GITHUB_REPOSITORY).\n");
        \fwrite(\STDERR, "       --ci-timeout <seconds>    Poll up to N seconds waiting for completion (default: 0).\n");
        \fwrite(\STDERR, "       Auth token is read from \$LOOM_RELEASE_PAT or \$GITHUB_TOKEN.\n");
        exit(1);
    }

    $repoName = $subArgs[0];
    $version = $subArgs[1];

    // Parse optional flags.
    $message = "Release {$version}";
    $requireCiGreen = false;
    $ciWorkflow = 'packages-ci.yml';
    $ciBranch = \getenv('GITHUB_REF_NAME') ?: 'main';
    $ciRepo = null;  // null = derive from GITHUB_REPOSITORY env var in CiGate
    $ciTimeout = 0;

    for ($i = 2; $i < \count($subArgs); $i++) {
        $arg = $subArgs[$i];
        $next = $subArgs[$i + 1] ?? null;
        if ($arg === '--message' && $next !== null) {
            $message = $next;
            $i++;
        } elseif ($arg === '--require-ci-green') {
            $requireCiGreen = true;
        } elseif ($arg === '--ci-workflow' && $next !== null) {
            $ciWorkflow = $next;
            $i++;
        } elseif ($arg === '--ci-branch' && $next !== null) {
            $ciBranch = $next;
            $i++;
        } elseif ($arg === '--ci-repo' && $next !== null) {
            $ciRepo = $next;
            $i++;
        } elseif ($arg === '--ci-timeout' && $next !== null) {
            $ciTimeout = (int) $next;
            $i++;
        }
    }

    $repoRoot = \dirname(__DIR__);
    $package = MonorepoPackage::find($repoRoot, $repoName);

    if ($package !== null) {
        $manager = $package->createRepoManager($repoRoot);
    } else {
        $repoDir = getRepoDir($repoName);
        $manager = new RepoManager($repoDir);
    }

    // P1 gap 6: --require-ci-green checks the latest GitHub Actions workflow
    // run on the configured branch BEFORE creating the tag. Refuses to tag a
    // red main. Token is read from $LOOM_RELEASE_PAT or $GITHUB_TOKEN.
    if ($requireCiGreen) {
        $token = \getenv('LOOM_RELEASE_PAT') ?: (\getenv('GITHUB_TOKEN') ?: '');

        $gateOwner = null;
        $gateName = null;
        if ($ciRepo !== null) {
            $parts = \explode('/', $ciRepo);
            $gateOwner = $parts[0] ?? null;
            $gateName = $parts[1] ?? null;
        }

        $gate = new CiGate($gateOwner, $gateName);
        $gate->setToken($token);

        try {
            $gate->assertGreen($ciWorkflow, $ciBranch, $ciTimeout);
            echo "CI gate passed: latest run of {$ciWorkflow} on {$ciBranch} is green.\n";
        } catch (\RuntimeException $e) {
            \fwrite(\STDERR, "Error: " . $e->getMessage() . "\n");
            \fwrite(\STDERR, "Refusing to create tag — main is not green.\n");
            exit(1);
        }
    }

    try {
        $manager->tag($version, $message);
        // Compute the actual tag name for display
        $prefix = $manager->getTagPrefix();
        $tagName = $prefix !== null ? "{$prefix}-v{$version}" : $version;
        echo "Tag '{$tagName}' created successfully for '{$repoName}'.\n";
        echo "Note: tag was created locally. Use `loom tag:push {$repoName} {$version}` to push it.\n";
    } catch (\RuntimeException $e) {
        \fwrite(\STDERR, "Error: " . $e->getMessage() . "\n");
        exit(1);
    }
}

function handleTagPush(array $subArgs): void
{
    if (\count($subArgs) < 2) {
        \fwrite(\STDERR, "Usage: loom tag:push <package> <version> [remote-url]\n");
        \fwrite(\STDERR, "       If remote-url is omitted, uses \$LOOM_REMOTE_URL or 'origin'.\n");
        \fwrite(\STDERR, "       For HTTPS remotes, embed the PAT in the URL (one-shot, never persisted).\n");
        exit(1);
    }

    $repoName = $subArgs[0];
    $version = $subArgs[1];
    $remoteUrl = $subArgs[2] ?? \getenv('LOOM_REMOTE_URL') ?: 'origin';

    $repoRoot = \dirname(__DIR__);
    $package = MonorepoPackage::find($repoRoot, $repoName);

    if ($package !== null) {
        $manager = $package->createRepoManager($repoRoot);
    } else {
        $repoDir = getRepoDir($repoName);
        $manager = new RepoManager($repoDir);
    }

    try {
        $manager->pushTag($version, $remoteUrl);
        $prefix = $manager->getTagPrefix();
        $tagName = $prefix !== null ? "{$prefix}-v{$version}" : $version;
        echo "Tag '{$tagName}' pushed to '{$remoteUrl}'.\n";
    } catch (\RuntimeException $e) {
        \fwrite(\STDERR, "Error: " . $e->getMessage() . "\n");
        exit(1);
    }
}

function handlePackageList(array $subArgs): void
{
    $repoRoot = \dirname(__DIR__);
    $packages = MonorepoPackage::discover($repoRoot);

    if ($packages === []) {
        echo "No monorepo library packages found under {$repoRoot}/packages/*/*/composer.json\n";
        return;
    }

    echo "Monorepo library packages ({$repoRoot}):\n\n";
    echo \str_pad('  Name', 30) . \str_pad('Path', 35) . \str_pad('Prefix', 30) . "Legacy\n";
    echo '  ' . \str_repeat('-', 100) . "\n";
    foreach ($packages as $package) {
        $legacy = $package->legacyTagPattern ?? '-';
        echo \str_pad("  {$package->name}", 30)
            . \str_pad($package->path, 35)
            . \str_pad($package->tagPrefix, 30)
            . $legacy . "\n";
    }
}

function handleStatusClean(array $subArgs): void
{
    // Parse --allow-untracked flag (can be repeated).
    $allowUntracked = [];
    for ($i = 0; $i < \count($subArgs); $i++) {
        if ($subArgs[$i] === '--allow-untracked' && isset($subArgs[$i + 1])) {
            $allowUntracked[] = $subArgs[$i + 1];
            $i++;
        }
    }

    // Use the repo root as the working dir (monorepo context).
    $repoRoot = \dirname(__DIR__);
    $manager = new RepoManager($repoRoot);

    try {
        $manager->assertClean($allowUntracked);
        echo "Working tree is clean.\n";
    } catch (\RuntimeException $e) {
        \fwrite(\STDERR, "Error: " . $e->getMessage() . "\n");
        exit(1);
    }
}

function handleStatus(array $subArgs): void
{
    $config = loadConfig();
    $graph = new DependencyGraph();

    $tierMap = [
        'core' => [],
        'hub' => [],
        'spoke' => [],
    ];

    foreach ($config as $repo) {
        $graph->addNode($repo['name'], $repo['tier'] ?? 'core');
    }

    foreach ($config as $repo) {
        $deps = $repo['depends_on'] ?? [];
        foreach ($deps as $dep) {
            try {
                $graph->addDependency($repo['name'], $dep);
            } catch (\RuntimeException) {
                // Skip invalid dependencies
            }
        }

        $tier = $repo['tier'] ?? 'core';
        $tierMap[$tier][] = $repo['name'];
    }

    $resolutionOrder = [];
    try {
        $resolutionOrder = $graph->getResolutionOrder();
    } catch (\RuntimeException $e) {
        \fwrite(\STDERR, "Warning: Could not resolve dependency order: " . $e->getMessage() . "\n");
    }

    echo "\n=== Polyrepo Status ===\n\n";

    echo "Tier Breakdown:\n";
    foreach (['core', 'hub', 'spoke'] as $tier) {
        $names = $tierMap[$tier];
        echo "  " . \ucfirst($tier) . " (" . \count($names) . "): " . ($names !== [] ? \implode(', ', $names) : '(none)') . "\n";
    }

    echo "\nResolution Order:\n";
    if ($resolutionOrder !== []) {
        foreach ($resolutionOrder as $i => $name) {
            $tier = $graph->getTier($name);
            echo "  " . ($i + 1) . ". {$name} [{$tier}]\n";
        }
    } else {
        echo "  (unresolved)\n";
    }

    echo "\nRegistered Repos:\n";
    foreach ($config as $repo) {
        echo "  - {$repo['name']} ({$repo['ci_url']})\n";
    }
}

// ─── Helper Functions ───────────────────────────────────────────────────────

function printUsage(): void
{
    echo <<<USAGE
The Loom — CORE-01 Polyrepo Orchestrator

Usage:
  loom ci:monitor --all          Run CI monitor against all registered repos
  loom ci:monitor <repo>         Run CI monitor against a specific repo
  loom version:bump <package>    Analyze commits and suggest a version bump
  loom tag:create <package> <v> [options]
                                 Create a git tag locally (use tag:push to push)
  loom tag:push <package> <v> [remote-url]
                                 Push a previously-created tag to a remote
  loom package:list              List monorepo packages discovered under packages/*/
  loom status:clean [--allow-untracked <path>]
                                 Exit 0 if working tree is clean, 1 otherwise
  loom status                    Show status of all registered repos
  loom                           Display this usage information

tag:create options:
  --message <msg>           Annotated-tag message (default: "Release <version>").
  --require-ci-green        Refuse to tag if the latest run of --ci-workflow
                            is not green (conclusion === 'success').
  --ci-workflow <file>      Workflow file name (default: packages-ci.yml).
  --ci-branch <name>        Branch to check (default: $GITHUB_REF_NAME or 'main').
  --ci-repo <owner/name>    GitHub repo (default: $GITHUB_REPOSITORY).
  --ci-timeout <seconds>    Poll up to N seconds waiting for completion (default: 0).
                            Auth token is read from $LOOM_RELEASE_PAT or $GITHUB_TOKEN.

<package> is a monorepo package name (e.g. core/container) — discovered
automatically from packages/*/*/composer.json. Falls back to repos.json
lookup for non-monorepo repositories.

For tag:push with HTTPS remotes, embed the PAT in the URL:
  loom tag:push core/container 1.1.0 https://x-access-token:\$PAT@github.com/owner/repo.git
or set \$LOOM_REMOTE_URL with the token-embedded URL.

USAGE;
}

/**
 * @return array<int, array{name: string, ci_url: string, token?: string, tier?: string, depends_on?: array<int, string>}>
 */
function loadConfig(): array
{
    $configPath = __DIR__ . '/../repos.json';

    if (\file_exists($configPath)) {
        $content = \file_get_contents($configPath);
        $decoded = \json_decode($content, true);

        if (\is_array($decoded)) {
            return $decoded;
        }
    }

    // Return default repos.json content if the file doesn't exist yet
    return getDefaultConfig();
}

/**
 * @return array<int, array{name: string, ci_url: string, token: string, tier: string, depends_on: array<int, string>}>
 */
function getDefaultConfig(): array
{
    $baseDir = \dirname(__DIR__);

    return [
        [
            'name' => 'orchestrator',
            'ci_url' => $baseDir,
            'token' => '',
            'tier' => 'core',
            'depends_on' => [],
        ],
    ];
}

function getRepoDir(string $repoName): string
{
    $config = loadConfig();

    foreach ($config as $repo) {
        if ($repo['name'] === $repoName) {
            return $repo['ci_url'];
        }
    }

    return \dirname(__DIR__) . '/repos/' . $repoName;
}

/**
 * @param array<string, array{status: string, details: string}> $results
 */
function printResultsTable(array $results): void
{
    $padName = 28;
    $padStatus = 7;

    echo "  Repo" . \str_repeat(' ', $padName - 4) . "CI Status  Details\n";
    echo "  " . \str_repeat('-', $padName + $padStatus + 40) . "\n";

    foreach ($results as $name => $result) {
        $statusDisplay = \strtoupper($result['status']);
        $statusColored = $result['status'] === 'pass'
            ? "\033[32m{$statusDisplay}\033[0m"
            : "\033[31m{$statusDisplay}\033[0m";

        $details = \mb_strlen($result['details']) > 50
            ? \mb_substr($result['details'], 0, 47) . '...'
            : $result['details'];

        \printf(
            "  %-{$padName}s %-{$padStatus}s %s\n",
            $name,
            $statusColored,
            $details
        );
    }
}